-- Binder-Seiten (31.07., Nutzer-Vorgabe "den echten Binder 1:1 abbilden") -
-- siehe Kommentar bei BinderEntity/BinderItemEntity in Portfolio.sq.
ALTER TABLE BinderEntity ADD COLUMN pageSize INTEGER NOT NULL DEFAULT 9;
ALTER TABLE BinderItemEntity ADD COLUMN position INTEGER NOT NULL DEFAULT 0;
ALTER TABLE BinderItemEntity ADD COLUMN positionUpdatedAt INTEGER NOT NULL DEFAULT 0;

-- Bereits vorhandene Binder-Karten (aus der Zeit vor Seiten/Position) bekommen
-- eine sinnvolle Startanordnung statt alle auf Position 0 zu kollidieren -
-- nach Hinzufügereihenfolge, exakt wie sie bisher ohne Seiten angezeigt
-- wurden. Der Nutzer kann das danach jederzeit per Kartentausch an seinen
-- echten Binder anpassen.
UPDATE BinderItemEntity
SET position = (
    SELECT ranked.rn - 1
    FROM (
        SELECT id, ROW_NUMBER() OVER (PARTITION BY binderId ORDER BY addedAt ASC, id ASC) AS rn
        FROM BinderItemEntity
    ) AS ranked
    WHERE ranked.id = BinderItemEntity.id
);
